note SPDX-License-Identifier: Apache-2.0
note src/ufbi_check1_kernels.om: Pure Seeded-OM-2 SM121 Direct SASS Emitter for Check #1
note (4D Massive Free Scalar Masked Helmholtz Stencil, CTA Parallel Dot Product, AXPY, Mask-Copy).
note Composed after om/encoder/bw_enc_sm121.om.
note Honors all SM121 silicon laws (Antibodies #13-#15: 6-cycle ALU floor, BB leader pinning,
note disjoint LDS/LDG address registers before qW0/qW1, zero B0 nesting).

const UZ ulong 255
global uPc ulong 1
global uGuard ulong 1
global uCodeBuf ulong 8192

fn ucw st ulong wb ulong rbar ulong wt ulong yld ulong to ulong
a = or shl st 9 shl yld 13
b = or shl wb 14 shl rbar 17
ret or or a b shl wt 20
end

fn uAlu4 to ulong
ret ucw 6 7 7 0 0
end
fn uCmp to ulong
ret ucw 14 7 7 0 0
end
fn uLd to ulong
ret ucw 2 0 1 0 1
end
fn uSt to ulong
ret ucw 4 7 1 0 1
end
fn uW0 to ulong
ret ucw 6 7 7 1 0
end
fn uW1 to ulong
ret ucw 6 7 7 2 0
end
fn uWall to ulong
ret ucw 6 7 7 7 0
end
fn uShfl to ulong
ret ucw 4 0 7 0 1
end
fn uSafe to ulong
ret ucw 6 7 7 7 0
end

fn uEmitRaw o edit ulong 16 atPc ulong to void
w = new ulong 4 0
if ne get uGuard 0 0
put o 9 1
end
if eq get uGuard 0 2
put o 10 1
end
put uGuard 0 0
if ne get o 2 UZ
put o 12 1
end
if ne get o 3 UZ
put o 13 1
end
if ne enc1 o w 0
exit 3
end
base = mul atPc 4
for i ulong 4
put uCodeBuf add base i get w i
end
end

fn uic op ulong dst ulong a ulong b ulong imm ulong ctrl ulong to void
o = new ulong 16 0
put o 0 op
put o 1 dst
put o 2 a
put o 3 b
put o 4 UZ
put o 5 4
put o 6 and imm 0xffffffff
put o 7 ctrl
pc = get uPc 0
uEmitRaw o pc
put uPc 0 add pc 1
end

fn uic4 op ulong dst ulong a ulong b ulong c ulong ctrl ulong to void
o = new ulong 16 0
put o 0 op
put o 1 dst
put o 2 a
put o 3 b
put o 4 c
put o 5 4
put o 6 0
put o 7 ctrl
pc = get uPc 0
uEmitRaw o pc
put uPc 0 add pc 1
end

fn uicImm op ulong dst ulong a ulong c ulong imm ulong ctrl ulong to void
o = new ulong 16 0
put o 0 op
put o 1 dst
put o 2 a
put o 3 UZ
put o 4 c
put o 5 4
put o 6 and imm 0xffffffff
put o 7 ctrl
pc = get uPc 0
uEmitRaw o pc
put uPc 0 add pc 1
end

fn uBraFwd gd ulong to ulong
pos = get uPc 0
put uGuard 0 gd
uic 46 UZ UZ UZ 0 uAlu4
ret pos
end

fn uPatch pos ulong gd ulong to void
o = new ulong 16 0
put o 0 46
put o 1 UZ
put o 2 UZ
put o 3 UZ
put o 4 UZ
put o 5 4
put o 6 and sub get uPc 0 pos 0xffffffff
put o 7 uAlu4
put uGuard 0 gd
uEmitRaw o pos
end

fn uLit d ulong x ulong to void
uic 2 d UZ UZ x uAlu4
end

fn uParam d ulong off ulong to void
uic 4 d UZ UZ add 896 off ucw 4 0 7 0 1
uic 0 UZ UZ UZ 0 uW0
end

fn uStart ptrs ulong to void
uic 7 4 UZ UZ 856 ucw 4 2 7 0 1
for i ulong ptrs bound 8
uic 5 mul i 2 UZ UZ add 896 mul i 8 ucw 4 0 7 0 1
end
uic 3 14 UZ UZ 33 ucw 4 0 7 0 1
uic 3 15 UZ UZ 37 ucw 4 0 7 0 1
uic 0 UZ UZ UZ 0 uWall
end

fn uBar to void
uic 0 UZ UZ UZ 0 uWall
uic 48 UZ UZ UZ 0 uSafe
end

fn uWarpBflySum acc ulong tmp ulong to void
d = ulong 16
while ge d 1 bound 5
uic 60 tmp acc UZ d uShfl
uic 30 acc acc tmp 0 uW0
d = shr d 1
end
end

fn uDone to void
uic 0 UZ UZ UZ 0 uWall
uic 45 UZ UZ UZ 0 uSafe
while or lt get uPc 0 32 ne rem get uPc 0 8 0 bound 2048
uic 0 UZ UZ UZ 0 uSafe
end
w = new ulong 4 0
n = get uPc 0
for pc ulong n bound 2048
base = mul pc 4
for i ulong 4
put w i get uCodeBuf add base i
end
uCodeWrite w
end
end

note =========================================================================
note Kernel 0: k_helm4d (Masked 4D 9-point Helmholtz Stencil)
note Args:
note   ptr0 (R0:R1) = x (f32[N])
note   ptr1 (R2:R3) = y (f32[N])
note   ptr2 (R4:R5) = mask (f32[N], 0.0 on frozen/boundary, 1.0 on active interior)
note   off 24 = N
note   off 28 = L
note   off 32 = L2
note   off 36 = L3
note   off 40 = negL  (0 - L as u32)
note   off 44 = negL2 (0 - L2 as u32)
note   off 48 = negL3 (0 - L3 as u32)
note   off 52 = diag_f32_bits (8.0 + ma^2)
note =========================================================================
fn uEmitHelm4d to bool
uStart 3
uParam 20 24
uParam 21 28
uParam 22 32
uParam 23 36
uParam 24 40
uParam 25 44
uParam 26 48
uParam 27 52
note gidx (R16) = CTAID.X (R15) * 256 + TID.X (R14)
uicImm 8 16 15 14 256 uAlu4
uic 28 UZ 16 20 0 uCmp
bOob = uBraFwd 1

note Load mask[gidx] into R17
uicImm 9 28 16 4 4 uAlu4
uic 11 17 28 UZ 0 uLd
uic 0 UZ UZ UZ 0 uW0

note Check mask != 0 (f32 0.0 is 0u32; 1.0 is 0x3f800000 >= 1)
uLit 18 1
uic 28 UZ 17 18 0 uCmp
bZero = uBraFwd 2

note Active strictly-interior site: load x[gidx] and 8 neighbors
note Batch 1: x[gidx], x[gidx+1], x[gidx-1], x[gidx+L]
uLit 19 0xffffffff
uic 14 30 16 18 0 uAlu4
uic 14 31 16 19 0 uAlu4
uic 14 32 16 21 0 uAlu4
uicImm 9 34 16 0 4 uAlu4
uicImm 9 36 30 0 4 uAlu4
uicImm 9 38 31 0 4 uAlu4
uicImm 9 40 32 0 4 uAlu4
uic 11 42 34 UZ 0 uLd
uic 11 43 36 UZ 0 uLd
uic 11 44 38 UZ 0 uLd
uic 11 45 40 UZ 0 uLd
uic 0 UZ UZ UZ 0 uW0
uic 30 46 43 44 0 uAlu4
uic 30 46 46 45 0 uAlu4

note Batch 2: x[gidx-L], x[gidx+L2], x[gidx-L2], x[gidx+L3]
uic 14 30 16 24 0 uAlu4
uic 14 31 16 22 0 uAlu4
uic 14 32 16 25 0 uAlu4
uic 14 33 16 23 0 uAlu4
uicImm 9 34 30 0 4 uAlu4
uicImm 9 36 31 0 4 uAlu4
uicImm 9 38 32 0 4 uAlu4
uicImm 9 40 33 0 4 uAlu4
uic 11 43 34 UZ 0 uLd
uic 11 44 36 UZ 0 uLd
uic 11 45 38 UZ 0 uLd
uic 11 47 40 UZ 0 uLd
uic 0 UZ UZ UZ 0 uW0
uic 30 46 46 43 0 uAlu4
uic 30 46 46 44 0 uAlu4
uic 30 46 46 45 0 uAlu4
uic 30 46 46 47 0 uAlu4

note Batch 3: x[gidx-L3]
uic 14 30 16 26 0 uAlu4
uicImm 9 34 30 0 4 uAlu4
uic 11 43 34 UZ 0 uLd
uic 0 UZ UZ UZ 0 uW0
uic 30 46 46 43 0 uAlu4

note val = diag * x[gidx] - sum_neighbors
uic 32 48 27 42 0 uAlu4
uic 31 48 48 46 0 uAlu4

note Store y[gidx] = val
uicImm 9 34 16 2 4 uAlu4
uic 12 UZ 34 48 0 uSt
uic 0 UZ UZ UZ 0 uW1
bDone = uBraFwd 0

note Zero path: y[gidx] = 0.0
uPatch bZero 2
uic 1 48 UZ UZ 0 uAlu4
uicImm 9 34 16 2 4 uAlu4
uic 12 UZ 34 48 0 uSt
uic 0 UZ UZ UZ 0 uW1

uPatch bDone 0
uPatch bOob 1
ret true
end

note =========================================================================
note Kernel 1: k_dot_cta (256-thread CTA parallel dot product -> part[ctaid])
note Args:
note   ptr0 (R0:R1) = u (f32[N])
note   ptr1 (R2:R3) = v (f32[N])
note   ptr2 (R4:R5) = part (f32[grid_x])
note   off 24 = N
note SMEM: 32 bytes (8 warp partial sums)
note =========================================================================
fn uEmitDotCta to bool
uStart 3
uParam 20 24
note gidx (R16) = CTAID.X * 256 + TID.X
uicImm 8 16 15 14 256 uAlu4
uic 1 22 UZ UZ 0 uAlu4
uic 28 UZ 16 20 0 uCmp
bSkip = uBraFwd 1

uicImm 9 24 16 0 4 uAlu4
uicImm 9 26 16 2 4 uAlu4
uic 11 28 24 UZ 0 uLd
uic 11 29 26 UZ 0 uLd
uic 0 UZ UZ UZ 0 uW0
uic 32 22 28 29 0 uAlu4

uPatch bSkip 1
note All 256 threads in CTA participate in warp butterfly sum
uWarpBflySum 22 23

note lane = tid & 31 (R30), warp = tid >> 5 (R31), smem_off = warp << 2 (R32)
uic 18 30 14 UZ 31 uAlu4
uic 17 31 14 UZ 5 uAlu4
uicImm 8 32 31 UZ 4 uAlu4
uLit 33 1
uic 28 UZ 30 33 0 uCmp
bNotLane0 = uBraFwd 1
uic 50 UZ 32 22 0 uSt
uic 0 UZ UZ UZ 0 uW1
uPatch bNotLane0 1

uBar

note Only tid == 0 sums the 8 warp slots in SMEM and writes part[ctaid]
uic 28 UZ 14 33 0 uCmp
bNotT0 = uBraFwd 1
note Precompute 8 disjoint SMEM byte offsets 0..28 in R34..R41
uLit 34 0
uLit 35 4
uLit 36 8
uLit 37 12
uLit 38 16
uLit 39 20
uLit 40 24
uLit 41 28
uic 49 42 34 UZ 0 uLd
uic 49 43 35 UZ 0 uLd
uic 49 44 36 UZ 0 uLd
uic 49 45 37 UZ 0 uLd
uic 0 UZ UZ UZ 0 uW0
uic 30 42 42 43 0 uAlu4
uic 30 44 44 45 0 uAlu4
uic 30 42 42 44 0 uAlu4
uic 49 46 38 UZ 0 uLd
uic 49 47 39 UZ 0 uLd
uic 49 48 40 UZ 0 uLd
uic 49 49 41 UZ 0 uLd
uic 0 UZ UZ UZ 0 uW0
uic 30 46 46 47 0 uAlu4
uic 30 48 48 49 0 uAlu4
uic 30 46 46 48 0 uAlu4
uic 30 42 42 46 0 uAlu4
uicImm 9 50 15 4 4 uAlu4
uic 12 UZ 50 42 0 uSt
uic 0 UZ UZ UZ 0 uW1
uPatch bNotT0 1
ret true
end

note =========================================================================
note Kernel 2: k_axpy (y[i] = a * x[i] + b * y[i])
note Args:
note   ptr0 (R0:R1) = x (f32[N])
note   ptr1 (R2:R3) = y (f32[N])
note   off 16 = N
note   off 20 = a_f32_bits
note   off 24 = b_f32_bits
note =========================================================================
fn uEmitAxpy to bool
uStart 2
uParam 20 16
uParam 21 20
uParam 22 24
uicImm 8 16 15 14 256 uAlu4
uic 28 UZ 16 20 0 uCmp
bOob = uBraFwd 1

uicImm 9 24 16 0 4 uAlu4
uicImm 9 26 16 2 4 uAlu4
uic 11 28 24 UZ 0 uLd
uic 11 29 26 UZ 0 uLd
uic 0 UZ UZ UZ 0 uW0
uic 32 30 22 29 0 uAlu4
uic4 33 30 21 28 30 uAlu4
uic 12 UZ 26 30 0 uSt
uic 0 UZ UZ UZ 0 uW1

uPatch bOob 1
ret true
end

note =========================================================================
note Kernel 3: k_mask_copy (y[i] = mask[i] * x[i])
note Args:
note   ptr0 (R0:R1) = x (f32[N])
note   ptr1 (R2:R3) = y (f32[N])
note   ptr2 (R4:R5) = mask (f32[N])
note   off 24 = N
note =========================================================================
fn uEmitMaskCopy to bool
uStart 3
uParam 20 24
uicImm 8 16 15 14 256 uAlu4
uic 28 UZ 16 20 0 uCmp
bOob = uBraFwd 1

uicImm 9 24 16 0 4 uAlu4
uicImm 9 26 16 2 4 uAlu4
uicImm 9 28 16 4 4 uAlu4
uic 11 30 24 UZ 0 uLd
uic 11 31 28 UZ 0 uLd
uic 0 UZ UZ UZ 0 uW0
uic 32 30 30 31 0 uAlu4
uic 12 UZ 26 30 0 uSt
uic 0 UZ UZ UZ 0 uW1

uPatch bOob 1
ret true
end
