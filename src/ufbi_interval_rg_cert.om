note SPDX-License-Identifier: Apache-2.0
note src/ufbi_interval_rg_cert.om: Pure Seeded-OM-2 Zero-Monte-Carlo Deterministic
note Binary64 box estimates for the TV, W1, and character-expansion criteria.
note The scan uses padded endpoints over angle and staple-field boxes.
note End-to-end roundoff analysis remains open.
note Composed after: src/ufbi_math.om and src/ufbi_ivmath.om

note Interval scratch registers (each interval = 2 f64: [lo, hi])
global ivA f64 2
global ivB f64 2
global ivC f64 2
global ivZ f64 2
global ivM f64 2
global ivM2 f64 2
global ivTh f64 2
global ivThC f64 2
global ivMad f64 2
global ivU12 f64 2
global ivU1 f64 2
global ivAcc f64 10
global ivStep f64 8

note Global estimated maxima across r in [0, 6*beta]
global maxMadHi f64 1
global maxW1Hi f64 1
global maxVparHi f64 1
global maxVperpHi f64 1

text tIvHdr "=== PHASE III-A ZERO-MONTE-CARLO INTERVAL-ARITHMETIC 4D SU(2) CONTRACTION VERIFIER (PURE OM-2) ===\n"
text tIvNote "# Padded binary64 [lo, hi] estimates (rel=1e-12, abs=1e-13), 2048 theta-boxes x 32 r-boxes covering ALL r in [0, 6*beta]\n"
text tIvCols "beta\tTV_osc_hi\tTV_S3L1_hi\tW1_geod_hi\tTG14_W1_hi\tu12_lo\tu12_hi\tu1_hi\tKP_surf_hi\tdecim_u12_4_hi\tcert_tier\n"
text tIvT0 "NONE"
text tIvT1 "T1_TV_OSC"
text tIvT2 "T2_TV_S3L1"
text tIvT3 "T3_W1_GEOD"
text tIvT3B "T3B_TG14_W1"
text tIvT4 "T4_KP_CHAR"
text tTab "\t"
text tNl "\n"
text tIvDone "INTERVAL_RG_CERT_DONE status=PASS\n"

fn min2 a f64 b f64 to f64
if lt a b
ret a
end
ret b
end

fn max2 a f64 b f64 to f64
if gt a b
ret a
end
ret b
end

fn ivMulLo alo f64 ahi f64 blo f64 bhi f64 to f64
p1 = mul alo blo
p2 = mul alo bhi
p3 = mul ahi blo
p4 = mul ahi bhi
ret ivLo min2 min2 p1 p2 min2 p3 p4
end

fn ivMulHi alo f64 ahi f64 blo f64 bhi f64 to f64
p1 = mul alo blo
p2 = mul alo bhi
p3 = mul ahi blo
p4 = mul ahi bhi
ret ivHi max2 max2 p1 p2 max2 p3 p4
end

note Box estimate of sin(t) on [t0, t1] subset [0, pi]
fn encloseS3Trig i ulong dt f64 to void
t0 = mul f64 i dt
t1 = mul f64 add i 1 dt
put ivStep 0 t0
put ivStep 1 t1
put ivStep 2 gridCosLo i
put ivStep 3 gridCosHi i
put ivStep 6 gridSinSqLo i
put ivStep 7 gridSinSqHi i
end

fn encloseS3Weight dt f64 rLo f64 rHi f64 to void
cLo = get ivStep 2
cHi = get ivStep 3
eLo = ivLo uExp64 ivMulLo rLo rHi cLo cHi
eHi = ivHi uExp64 ivMulHi rLo rHi cLo cHi
wScale = mul div 2.0f64 uPi dt
wLo = ivLo mul wScale mul get ivStep 6 eLo
wHi = ivHi mul wScale mul get ivStep 7 eHi
if lt wLo 0.0f64
wLo = 0.0f64
end
put ivStep 4 wLo
put ivStep 5 wHi
end

fn encloseS3Step i ulong dt f64 rLo f64 rHi f64 to void
encloseS3Trig i dt
encloseS3Weight dt rLo rHi
end

fn accumS3Step to void
t0 = get ivStep 0
t1 = get ivStep 1
cLo = get ivStep 2
cHi = get ivStep 3
wLo = get ivStep 4
wHi = get ivStep 5
put ivAcc 0 ivLo add get ivAcc 0 wLo
put ivAcc 1 ivHi add get ivAcc 1 wHi
put ivAcc 2 ivLo add get ivAcc 2 ivMulLo cLo cHi wLo wHi
put ivAcc 3 ivHi add get ivAcc 3 ivMulHi cLo cHi wLo wHi
csLo = 0.0f64
if gt cLo 0.0f64
csLo = ivLo mul cLo cLo
end
if lt cHi 0.0f64
csLo = ivLo mul cHi cHi
end
csHi = ivHi max2 mul cLo cLo mul cHi cHi
put ivAcc 4 ivLo add get ivAcc 4 mul csLo wLo
put ivAcc 5 ivHi add get ivAcc 5 mul csHi wHi
put ivAcc 6 ivLo add get ivAcc 6 mul t0 wLo
put ivAcc 7 ivHi add get ivAcc 7 mul t1 wHi
tcLoB = ivMulLo t0 t1 cLo cHi
tcHiB = ivMulHi t0 t1 cLo cHi
put ivAcc 8 ivLo add get ivAcc 8 ivMulLo tcLoB tcHiB wLo wHi
put ivAcc 9 ivHi add get ivAcc 9 ivMulHi tcLoB tcHiB wLo wHi
end

note Enclose S^3 vMF integrals uniformly over ALL r in [rLo, rHi] (0 <= rLo <= rHi)
note Outputs: ivZ, ivM, ivM2, ivTh, ivThC
fn encloseS3Box rLo f64 rHi f64 to void
dt = div uPi 2048.0f64
for k ulong 10
put ivAcc k 0.0f64
end
for i ulong 2048
encloseS3Step i dt rLo rHi
accumS3Step
end
zLo = get ivAcc 0
zHi = get ivAcc 1
put ivZ 0 zLo
put ivZ 1 zHi
put ivM 0 ivLo min2 div get ivAcc 2 zHi div get ivAcc 2 zLo
put ivM 1 ivHi max2 div get ivAcc 3 zLo div get ivAcc 3 zHi
put ivM2 0 ivLo div get ivAcc 4 zHi
put ivM2 1 ivHi div get ivAcc 5 zLo
put ivTh 0 ivLo div get ivAcc 6 zHi
put ivTh 1 ivHi div get ivAcc 7 zLo
put ivThC 0 ivLo min2 div get ivAcc 8 zHi div get ivAcc 8 zLo
put ivThC 1 ivHi max2 div get ivAcc 9 zLo div get ivAcc 9 zHi
end

fn encloseMadStep i ulong dt f64 rLo f64 rHi f64 to void
encloseS3Trig i dt
encloseS3Weight dt rLo rHi
dLo = ivLo sub get ivStep 2 get ivM 1
dHi = ivHi sub get ivStep 3 get ivM 0
absHi = max2 uAbs64 dLo uAbs64 dHi
put ivMad 0 ivHi add get ivMad 0 mul absHi get ivStep 5
end

note Separate pass for exact L1-MAD = E_r[|cos(t) - m(r)|] over r in [rLo, rHi] using enclosed m in [mLo, mHi]
fn encloseMadBox rLo f64 rHi f64 to void
dt = div uPi 2048.0f64
put ivMad 0 0.0f64
for i ulong 2048
encloseMadStep i dt rLo rHi
end
put ivMad 1 ivHi div get ivMad 0 get ivZ 0
end

fn uTanhHi x f64 to f64
if ge x 20.0f64
ret 1.0f64
end
e2 = ivHi uExp64 mul 2.0f64 x
e2lo = ivLo uExp64 mul 2.0f64 x
ret ivHi div sub e2 1.0f64 add e2lo 1.0f64
end

fn updateFieldMax r0 f64 r1 f64 to void
encloseS3Box r0 r1
encloseMadBox r0 r1
madH = get ivMad 1
if gt madH get maxMadHi 0
put maxMadHi 0 madH
end
prodHi = ivMulHi get ivTh 0 get ivTh 1 get ivM 0 get ivM 1
lParHi = ivHi sub prodHi get ivThC 0
if lt lParHi 0.0f64
lParHi = 0.0f64
end
lPerpHi = ivHi mul div uPi 8.0f64 sub 1.0f64 get ivM2 0
if lt lPerpHi 0.0f64
lPerpHi = 0.0f64
end
w1Hi = ivHi uSqrt64 ivHi add mul lParHi lParHi mul lPerpHi lPerpHi
if gt w1Hi get maxW1Hi 0
put maxW1Hi 0 w1Hi
end
end

note Scan ALL staple fields r in [0, 6*beta] in 32 interval boxes and report the coefficients.
fn certifyBeta beta f64 to void
dr = div mul 6.0f64 beta 32.0f64
put maxMadHi 0 0.0f64
put maxW1Hi 0 0.0f64
for k ulong 32
r0 = mul f64 k dr
r1 = mul f64 add k 1 dr
updateFieldMax r0 r1
end

encloseS3Box beta beta
put ivU12 0 get ivM 0
put ivU12 1 get ivM 1
put ivU1 1 ivHi div sub mul 4.0f64 get ivM2 1 1.0f64 3.0f64

tvOscHi = ivHi mul 18.0f64 uTanhHi beta
tvS3L1Hi = ivHi mul 18.0f64 mul beta get maxMadHi 0
w1GeodHi = ivHi mul 18.0f64 mul beta get maxW1Hi 0
tg14W1Hi = ivHi mul 14.0f64 mul beta get maxW1Hi 0
qKP = ivHi mul 13.591409143f64 get ivU12 1
kpHi = 999.0f64
if lt qKP 0.999f64
q2 = ivHi mul qKP qKP
q6 = ivHi mul q2 mul q2 q2
kpHi = ivHi div mul 4.0f64 q6 sub 1.0f64 qKP
end
u2 = ivHi mul get ivU12 1 get ivU12 1
dec4Hi = ivHi mul u2 u2

uPrintF64 beta
uPrint tTab
uPrintF64 tvOscHi
uPrint tTab
uPrintF64 tvS3L1Hi
uPrint tTab
uPrintF64 w1GeodHi
uPrint tTab
uPrintF64 tg14W1Hi
uPrint tTab
uPrintF64 get ivU12 0
uPrint tTab
uPrintF64 get ivU12 1
uPrint tTab
uPrintF64 get ivU1 1
uPrint tTab
uPrintF64 kpHi
uPrint tTab
uPrintF64 dec4Hi
uPrint tTab
if lt tvOscHi 1.0f64
uPrint tIvT1
else
if lt tvS3L1Hi 1.0f64
uPrint tIvT2
else
if lt w1GeodHi 1.0f64
uPrint tIvT3
else
if lt tg14W1Hi 1.0f64
uPrint tIvT3B
else
if lt kpHi 1.0f64
uPrint tIvT4
else
uPrint tIvT0
end
end
end
end
end
uPrint tNl
end

text tTrigFail "TRIG_ENDPOINT status=FAIL\n"

fn main to int
initTrigGrid
if eq trigGridOK 0
uPrint tTrigFail
ret 1
end
uPrint tIvHdr
uPrint tIvNote
uPrint tIvCols
certifyBeta 0.05f64
certifyBeta 0.08f64
certifyBeta 0.10f64
certifyBeta 0.11f64
certifyBeta 0.12f64
certifyBeta 0.1272f64
certifyBeta 0.130f64
certifyBeta 0.135f64
certifyBeta 0.140f64
certifyBeta 0.150f64
certifyBeta 0.160f64
certifyBeta 0.170f64
certifyBeta 0.180f64
certifyBeta 0.200f64
certifyBeta 0.250f64
certifyBeta 0.300f64
certifyBeta 0.400f64
certifyBeta 0.500f64
certifyBeta 1.000f64
certifyBeta 1.500f64
certifyBeta 2.000f64
certifyBeta 2.300f64
uPrint tIvDone
ret 0
end
