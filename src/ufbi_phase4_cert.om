note SPDX-License-Identifier: Apache-2.0
note src/ufbi_phase4_cert.om: Pure Seeded-OM-2 Zero-Monte-Carlo Phase IV Dual-Cliff Verifier
note
note Zero randomness, zero Monte Carlo, zero C/Python/Rust/libcuda:
note Part A scans 2048 angle boxes and 128 staple-field boxes for each sampled beta.
note It reports coefficients for 18, 14 and 12 neighbor incidences.
note Part B integrates core and tail terms for a single quaternion star cell at eight couplings.
note Part A uses integer dyadic quadrature and exact comparisons. Part B uses padded binary64.
note A rigorous end-to-end floating-point enclosure remains open.
note
note Composed after src/ufbi_math.om, src/ufbi_ivmath.om and src/ufbi_w2_dyadic.om.

note Part B globals (keep every fn <= 6 FP locals to stay inside omc FP reg pool)
global rowFailures ulong 1
global qPrm f64 16
global qRes f64 14
global qTmp f64 12
global qFar f64 8

text tP4Hdr "=== PHASE IV ZERO-MONTE-CARLO DUAL-CLIFF VERIFIER (PURE SEEDED OM-2) ===\n"
text tP4AHdr "=== PART A: RIGHT CLIFF — PERIOD-2 LINK INCIDENCES (deg=12) + DYADIC S^3 W_2 TRIAL ENERGIES (2048 x 128 BOXES) ===\n"
text tP4ACols "beta\tW2_par_hi\tW2_perp_hi\tL_W2_hi\tUnfix18_hi\tTG14_hi\tBT12_hi\tcert\n"
text tP4BHdr "=== PART B: PADDED BINARY64 STAR-CELL DIAGNOSTICS — 4-REGION SHIFTED QUATERNION LANDAU GAUGE (K_{2,2,2,2} + K_{1,2,2,2}) ===\n"
text tP4BCols "beta\tR1\tR7\tu_core\tcore_up_hi\tcore_dn_hi\tmid_hi\tgt_hi\t1bad_hi\t2bad_hi\tdTV_hi\tL1_hi\tstatus\n"
text tPassU "PASS_UNFIX18"
text tPassTG "PASS_TG14_W2"
text tPassBT "PASS_BT12_W2"
text tOpen "OPEN"
text tClosedL1 "CLOSED_FULL_L1"
text tClosedTV "CLOSED_TV_ONLY"
text tTab "\t"
text tNl "\n"
text tDone "PHASE4_CERT_DONE status=PASS\n"

fn min2 a f64 b f64 to f64
if lt a b
ret a
end
ret b
end

fn max2 a f64 b f64 to f64
if gt a b
ret a
end
ret b
end

fn ivMulHi alo f64 ahi f64 blo f64 bhi f64 to f64
p1 = mul alo blo
p2 = mul alo bhi
p3 = mul ahi blo
p4 = mul ahi bhi
ret ivHi max2 max2 p1 p2 max2 p3 p4
end

fn printPartACert u18 long tg14 long bt12 long expected ulong to void
actual = ulong 0
if ne u18 0
actual = ulong 18
uPrint tPassU
else
if ne tg14 0
actual = ulong 14
uPrint tPassTG
else
if ne bt12 0
actual = ulong 12
uPrint tPassBT
else
uPrint tOpen
end
end
end
uPrint tNl
if ne actual expected
put rowFailures 0 add get rowFailures 0 1
end
end

fn scanW2Beta bps long expected ulong to void
scanDyadicW2 bps
beta = div f64 bps 10000.0f64
par = uSqrt64 div f64 get wMaxEnergy 0 f64 wScale
perp = uSqrt64 div f64 get wMaxEnergy 1 f64 wScale
energy = larger get wMaxEnergy 0 get wMaxEnergy 1
lW2 = max2 par perp
u18 = mul 18.0f64 mul beta lW2
tg14 = mul 14.0f64 mul beta lW2
bt12 = mul 12.0f64 mul beta lW2
uPrintF64 beta
uPrint tTab
uPrintF64 par
uPrint tTab
uPrintF64 perp
uPrint tTab
uPrintF64 lW2
uPrint tTab
uPrintF64 u18
uPrint tTab
uPrintF64 tg14
uPrint tTab
uPrintF64 bt12
uPrint tTab
printPartACert dyadicSubunit energy 18 bps dyadicSubunit energy 14 bps dyadicSubunit energy 12 bps expected
end

note =========================================================================
note PART B: 4-Region Shifted Quaternion Landau Gauge (K_{2,2,2,2} + K_{1,2,2,2})
note   qPrm: 0=beta, 1=lam1, 2=lam2, 3=v, 4=c, 5=logZshiftLo, 6=ratioUpHi, 7=qCoeffHi,
note         8=eSumS2Hi, 9=logNormChi21Lo, 10=R1, 11=S1Hi, 12=u2Lo, 13=alphaMidHi, 14=s1FloorLo
note   qFar: 0=bestSum, 1=R7, 2=rMin, 3=tail1bHi, 4=tail2bHi
note   qRes: 0=L1, 1=dTV, 2=R1, 3=R7, 4=u, 5=remUp, 6=remDn, 7=midTail, 8=gtTail, 9=t1b, 10=t2b
note =========================================================================
note Exact log(2^{21/2} Gamma(21/2)) = log(654729075) + 0.5*log(2*pi) (lower bound => upper bound on density!)
fn initChi21Norm to void
ln19df = ivLo uLog64 654729075.0f64
ln2pi = ivLo uLog64 uTwoPi
put qPrm 9 ivLo add ln19df mul 0.5f64 ln2pi
end

note Outward-rounded upper bound on chi_21^2 density f(t) at point t > 0
fn fChi21PtHi t f64 to f64
if le t 0.0f64
ret 0.0f64
end
lg = ivHi mul 9.5f64 ivHi uLog64 t
ex = ivHi sub ivHi sub lg ivLo mul 0.5f64 t get qPrm 9
ret ivHi uExp64 ex
end

note Exact unimodal box upper bound on chi_21^2 density over [t0, t1] (unique peak at t = 19.0!)
fn fChi21BoxHi t0 f64 t1 f64 to f64
if and le t0 19.0f64 ge t1 19.0f64
ret fChi21PtHi 19.0f64
end
ret max2 fChi21PtHi t0 fChi21PtHi t1
end

note Exact outward-rounded upper bound on P(chi_21^2 > a) for a >= 19.0 (decreasing density on [a, 240] + Chernoff on [240, inf))
fn chi21TailHi a f64 to f64
if ge a 240.0f64
ret 0.000000000000001f64
end
h = ivHi div sub 240.0f64 a 400.0f64
acc = f64 0.0f64
for i ulong 400
t0 = add a mul f64 i h
acc = ivHi add acc ivHi mul fChi21BoxHi t0 add t0 h h
end
ret ivHi add acc 0.000000000000001f64
end

note Exact lower bound on log(Z_shift_q(beta)) for 8-link shifted quaternion Landau gauge
fn initBetaParams beta f64 to void
put qPrm 0 beta
lam1 = sub mul 6.0f64 beta 0.625f64
lam2 = sub mul 8.0f64 beta 0.625f64
put qPrm 1 lam1
put qPrm 2 lam2
v = add div 0.5f64 lam1 div 0.375f64 lam2
c = neg div 0.125f64 lam2
put qPrm 3 v
put qPrm 4 c
ln8 = ivLo uLog64 8.0f64
ln2pi = ivLo uLog64 uTwoPi
ln2pi2 = ivHi uLog64 mul 2.0f64 mul uPi uPi
num = ivLo add mul 1.5f64 ln8 mul 10.5f64 ln2pi
den = ivHi add mul 7.0f64 ln2pi2 ivHi add mul 6.0f64 ivHi uLog64 lam1 mul 4.5f64 ivHi uLog64 lam2
put qPrm 5 ivLo sub num den
put qPrm 6 ivHi div ivHi mul 120.0f64 ivHi mul ivHi mul v v ivHi mul lam1 lam1 483.0f64
v2mc2 = ivHi sub ivHi mul v v ivLo mul c c
put qPrm 7 ivHi div ivHi mul 36.0f64 ivHi mul beta v2mc2 483.0f64
eS = ivHi add ivHi div 12.0f64 lam1 ivHi div 9.0f64 lam2
varS = ivHi add ivHi div 24.0f64 ivLo mul lam1 lam1 ivHi div 18.0f64 ivLo mul lam2 lam2
put qPrm 8 ivHi add ivHi mul eS eS varS
end

note Exact lower bound on s1_floor(R) = 24*(1 - r_*^2) where 4 r_*^2 - cos(R)*r_* - 3 = 0
fn s1FloorLo R f64 to f64
cH = radialCosHi R
rH = ivHi div ivHi add cH ivHi uSqrt64 ivHi add ivHi mul cH cH 48.0f64 8.0f64
ret ivLo mul 24.0f64 ivLo sub 1.0f64 ivHi mul rH rH
end

note Exact lower bound on s2_floor(R) = 24*(1 - r_*^2) where 5 r_*^2 - 2*cos(R)*r_* - 3 = 0
fn s2FloorLo R f64 to f64
cH = radialCosHi R
rH = ivHi div ivHi add cH ivHi uSqrt64 ivHi add ivHi mul cH cH 15.0f64 5.0f64
ret ivLo mul 24.0f64 ivLo sub 1.0f64 ivHi mul rH rH
end

note Exact upper bound on S^3 Haar cap measure P(theta >= th0) = 1 - (th0 - sin(th0)*cos(th0))/pi
fn haarCapHi th0 f64 to f64
if le th0 0.0f64
ret 1.0f64
end
if ge th0 uPi
ret 0.0f64
end
scH = ivMulHi radialSinLo th0 radialSinHi th0 radialCosLo th0 radialCosHi th0
numL = ivLo sub th0 scH
ret ivHi sub 1.0f64 ivLo div numL uPi
end

note Upper bound on log Z_1bad(mu1, mu2) = [1.5 ln7 + 9 ln(2pi)] - [6 ln(2pi^2) + 4.5 ln mu1 + 4.5 ln mu2]
note (split out of eval1BadEta: one function holding all these values exceeded omc's 16-register pool, error 12)
fn lnZ1bHi mu1 f64 mu2 f64 to f64
ln7 = ivHi uLog64 7.0f64
ln2pi = ivHi uLog64 uTwoPi
numHi = ivHi add mul 1.5f64 ln7 mul 9.0f64 ln2pi
ln2pi2 = ivLo uLog64 mul 2.0f64 mul uPi uPi
lnMu1Lo = ivLo uLog64 mu1
lnMu2Lo = ivLo uLog64 mu2
muLo = ivLo add mul 4.5f64 lnMu1Lo mul 4.5f64 lnMu2Lo
denLo = ivLo add mul 6.0f64 ln2pi2 muLo
ret ivHi sub numHi denLo
end

note Evaluate 1-bad-link upper bound at given (eta, shift7, cap0)
fn eval1BadEta eta f64 shift7 f64 cap0 f64 to f64
beta = get qPrm 0
ome = ivLo sub 1.0f64 eta
mu1 = ivLo sub mul 5.0f64 mul ome beta shift7
mu2 = ivLo sub mul 7.0f64 mul ome beta shift7
if or le mu1 0.2f64 le mu2 0.2f64
ret 999.0f64
end
lnZ1b = lnZ1bHi mu1 mu2
arg = ivHi add ivHi sub lnZ1b get qPrm 5 neg ivLo mul eta ivLo mul get qPrm 14 beta
ret ivHi mul 8.0f64 ivHi mul cap0 ivHi uExp64 arg
end

note Shift for the 7 near links given the far-link sine bound s7 = sin(R7)^2 (split out of scan1BadR7, error 12)
fn shift7Hi R7 f64 s7 f64 to f64
sLo = radialSinLo R7
cLog7 = ivHi div neg ivLo uLog64 ivLo sub 1.0f64 s7 ivLo mul sLo sLo
ret max2 0.0f64 ivHi sub cLog7 div 3.0f64 7.0f64
end

note Best 1-bad-link bound over the 34-point eta grid (split out of scan1BadR7, error 12)
fn best1bOverEta shift7 f64 cap0 f64 to f64
best1b = f64 999.0f64
for ei ulong 34
eta = add 0.25f64 mul f64 ei 0.02f64
v1 = eval1BadEta eta shift7 cap0
if lt v1 best1b
best1b = v1
end
end
ret best1b
end

fn scan1BadR7 R7 f64 rMin f64 delta f64 cap0 f64 to void
beta = get qPrm 0
R1 = get qPrm 10
s7 = ivHi mul radialSinHi R7 radialSinHi R7
if ge s7 0.998f64
ret
end
r2Eff = min2 R1 ivLo sub R7 delta
if le r2Eff 0.5f64
ret
end
s2F = min2 ivLo mul 24.0f64 ivLo sub 1.0f64 ivHi mul rMin rMin s2FloorLo r2Eff
t2b = ivHi uExp64 ivHi sub neg ivLo mul s2F beta get qPrm 5
if gt t2b 0.5f64
ret
end
shift7 = shift7Hi R7 s7
best1b = best1bOverEta shift7 cap0
tot = ivHi add best1b t2b
if lt tot get qFar 0
put qFar 0 tot
put qFar 1 R7
put qFar 2 rMin
put qFar 3 best1b
put qFar 4 t2b
end
end

fn optimizeFarTails to void
R1 = get qPrm 10
put qFar 0 999.0f64
for rmi ulong 6
rMin = add 0.74f64 mul f64 rmi 0.02f64
note atan(x) <= x for x > 0 is an exact elementary upper bound!
delta = ivHi div 1.0f64 ivLo sub mul 8.0f64 rMin 1.0f64
cap0 = haarCapHi ivLo sub R1 delta
for r7i ulong 12
R7 = add 1.28f64 mul f64 r7i 0.02f64
scan1BadR7 R7 rMin delta cap0
end
end
end

note Single outward-rounded box step [t0, t1] for core integrals (remUp, dnQuat, dnFp)
fn coreBoxStep t0 f64 t1 f64 h f64 to void
lam1 = get qPrm 1
ftH = fChi21BoxHi t0 t1
stH = ivHi div t1 lam1
if ge stH 0.995f64
put qTmp 0 999.0f64
ret
end
omS = ivLo sub 1.0f64 stH
invSq = ivHi div 1.0f64 ivLo uSqrt64 omS
upVal = ivHi sub ivHi mul invSq ivHi uExp64 neg ivLo mul 0.5f64 ivLo div t0 lam1 1.0f64
if lt upVal 0.0f64
upVal = 0.0f64
end
put qTmp 0 ivHi add get qTmp 0 ivHi mul get qPrm 6 ivHi mul upVal ivHi mul ftH h
qVal = ivHi div ivHi mul t1 t1 omS
put qTmp 1 ivHi add get qTmp 1 ivHi mul get qPrm 7 ivHi mul qVal ivHi mul ftH h
end

note Faddeev-Popov remainder coefficient upper bound on a box with s in [stL, stH]
note (split out of coreBoxFpStep: one function holding all these values exceeded omc's 16-register pool, error 12)
fn fpCoeffHi stH f64 to f64
sqOm = ivLo uSqrt64 ivLo sub 1.0f64 stH
xH = ivHi sub 1.0f64 sqOm
note (1 - s/2 - sqrt(1-s))/s^2 = 1/(2*(1+sqrt(1-s))^2).
denL = ivLo add 1.0f64 sqOm
d2H = ivHi div 0.5f64 ivLo mul denL denL
note (-log(1-x)-x)/x^2 has a positive power series, hence increases in x.
note Evaluate at xH; enclose log(1-xH) directly at that same point.
c2XH = ivHi div ivHi sub neg ivLo uLog64 ivLo sub 1.0f64 xH xH ivLo mul xH xH
csqH = ivHi div 1.0f64 denL
tA = ivHi mul mul 0.375f64 d2H ivHi mul 120.0f64 ivHi mul get qPrm 3 get qPrm 3
tB = ivHi mul 3.0f64 ivHi mul c2XH ivHi mul ivHi mul div csqH 8.0f64 div csqH 8.0f64 get qPrm 8
ret ivHi div ivHi add tA tB 483.0f64
end

fn coreBoxFpStep t0 f64 t1 f64 h f64 to void
lam1 = get qPrm 1
ftH = fChi21BoxHi t0 t1
stH = ivHi div t1 lam1
if le stH 0.0001f64
stH = 0.0001f64
end
if ge stH 0.995f64
put qTmp 2 999.0f64
ret
end
fpC = fpCoeffHi stH
put qTmp 2 ivHi add get qTmp 2 ivHi mul fpC ivHi mul ivHi mul t1 t1 ivHi mul ftH h
end

fn evalMidLo u f64 u2 f64 to f64
if le u2 u
ret 0.0f64
end
lam1 = get qPrm 1
h = ivHi div sub u2 u 100.0f64
acc = f64 0.0f64
for i ulong 100
t0 = add u mul f64 i h
t1 = min2 u2 add t0 h
stH = ivHi div t1 lam1
omS = ivLo sub 1.0f64 stH
upV = ivHi sub ivHi mul ivHi div 1.0f64 ivLo uSqrt64 omS ivHi uExp64 neg ivLo mul 0.5f64 ivLo div t0 lam1 1.0f64
if lt upV 0.0f64
upV = 0.0f64
end
fac = ivHi add 1.0f64 ivHi mul get qPrm 6 upV
acc = ivHi add acc ivHi mul fac ivHi mul fChi21BoxHi t0 t1 h
end
ret acc
end

fn tryCoreU u f64 midHi f64 to void
u2 = get qPrm 12
put qTmp 0 0.0f64
put qTmp 1 0.0f64
put qTmp 2 0.0f64
h = ivHi div u 200.0f64
for i ulong 200
t0 = mul f64 i h
t1 = min2 u add t0 h
coreBoxStep t0 t1 h
coreBoxFpStep t0 t1 h
end
midTail = ivHi add evalMidLo u u2 midHi
gtTail = chi21TailHi u
aUp = ivHi add get qTmp 0 ivHi add midTail ivHi add get qFar 3 get qFar 4
aDn = ivHi add get qTmp 1 ivHi add get qTmp 2 gtTail
l1 = ivHi add aUp aDn
dTV = f64 9.99f64
if lt aDn 0.9999f64
dTV = max2 aUp ivHi div aDn ivLo sub 1.0f64 aDn
end
if lt l1 get qRes 0
put qRes 0 l1
put qRes 1 dTV
put qRes 2 get qPrm 10
put qRes 3 get qFar 1
put qRes 4 u
put qRes 5 get qTmp 0
put qRes 6 ivHi add get qTmp 1 get qTmp 2
put qRes 7 midTail
put qRes 8 gtTail
put qRes 9 get qFar 3
put qRes 10 get qFar 4
end
end

fn scanR1 R1 f64 to void
lam1 = get qPrm 1
put qPrm 10 R1
s1H = ivHi mul radialSinHi R1 radialSinHi R1
s1L = ivLo mul radialSinLo R1 radialSinLo R1
if ge s1H 0.996f64
ret
end
put qPrm 11 s1H
put qPrm 14 s1FloorLo R1
optimizeFarTails
if gt get qFar 0 0.8f64
ret
end
cLin1 = ivHi div ivHi sub neg ivLo uLog64 ivLo sub 1.0f64 s1H s1L s1L
alphaM = ivHi div cLin1 mul 2.0f64 lam1
if ge mul 2.0f64 alphaM 0.94f64
ret
end
put qPrm 13 alphaM
u2 = ivLo mul lam1 mul s1L 0.994f64
put qPrm 12 u2
scL = ivLo sub 1.0f64 mul 2.0f64 alphaM
scPow = ivHi uExp64 mul neg 10.5f64 ivLo uLog64 scL
midHi = ivHi mul scPow chi21TailHi ivLo mul scL u2
for ui ulong 24
u = add 28.0f64 mul f64 ui 2.0f64
if le u u2
tryCoreU u midHi
end
end
end

fn evalZeroLoopholeStar beta f64 expected ulong to void
initBetaParams beta
put qRes 0 999.0f64
put qRes 1 999.0f64
put qRes 2 0.0f64
put qRes 3 0.0f64
put qRes 4 0.0f64
put qRes 5 999.0f64
put qRes 6 999.0f64
put qRes 7 999.0f64
put qRes 8 999.0f64
put qRes 9 999.0f64
put qRes 10 999.0f64
for r1i ulong 16
R1 = add 1.20f64 mul f64 r1i 0.02f64
scanR1 R1
end
uPrintF64 beta
uPrint tTab
uPrintF64 get qRes 2
uPrint tTab
uPrintF64 get qRes 3
uPrint tTab
uPrintF64 get qRes 4
uPrint tTab
uPrintF64 get qRes 5
uPrint tTab
uPrintF64 get qRes 6
uPrint tTab
uPrintF64 get qRes 7
uPrint tTab
uPrintF64 get qRes 8
uPrint tTab
uPrintF64 get qRes 9
uPrint tTab
uPrintF64 get qRes 10
uPrint tTab
uPrintF64 get qRes 1
uPrint tTab
uPrintF64 get qRes 0
uPrint tTab
actual = ulong 0
if lt get qRes 0 1.0f64
actual = ulong 2
uPrint tClosedL1
else
if lt get qRes 1 1.0f64
actual = ulong 1
uPrint tClosedTV
else
uPrint tOpen
end
end
uPrint tNl
if ne actual expected
put rowFailures 0 add get rowFailures 0 1
end
end

text tRowFail "PHASE4_CERT_DONE status=FAIL\n"
text tTrigFail "TRIG_ENDPOINT status=FAIL\n"

fn main to int
initTrigGrid
initW2Angles
if eq trigGridOK 0
uPrint tTrigFail
ret 1
end
initChi21Norm
uPrint tP4Hdr
uPrint tP4AHdr
uPrint tP4ACols
scanW2Beta 1272 18
scanW2Beta 1800 18
scanW2Beta 2400 14
scanW2Beta 2600 12
scanW2Beta 2750 12
scanW2Beta 2800 12
scanW2Beta 2830 12
scanW2Beta 2880 0
if ne get wFailed 0 0
uPrint tRowFail
ret 1
end
uPrint tP4BHdr
uPrint tP4BCols
evalZeroLoopholeStar 6.0f64 1
evalZeroLoopholeStar 6.5f64 2
evalZeroLoopholeStar 7.0f64 2
evalZeroLoopholeStar 8.0f64 2
evalZeroLoopholeStar 10.0f64 2
evalZeroLoopholeStar 12.0f64 2
evalZeroLoopholeStar 15.0f64 2
evalZeroLoopholeStar 20.0f64 2
if ne get rowFailures 0 0
uPrint tRowFail
ret 1
end
uPrint tDone
ret 0
end
